    {
      "id": 4,
      "type": "table",
      "title": "Resources by verb",
      "description": "Audited requests per (resource, verb).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT ifNull(k8s_resource, 'unknown') AS resource, ifNull(k8s_verb, 'unknown') AS verb,\n       uniqExact(event_id) AS requests,\n       uniqExactIf(event_id, k8s_response_code = 403) AS denied,\n       uniqExact(k8s_user) AS users\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND event_type = 'k8s.api.request'\nGROUP BY resource, verb\nORDER BY requests DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
