    {
      "id": 5,
      "type": "table",
      "title": "Denied requests",
      "description": "403 responses incl. Pod Security violations (K8S-001 inputs).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT event_time, k8s_user AS user, k8s_verb AS verb, k8s_resource AS resource,\n       k8s_namespace AS namespace, k8s_object_name AS object, k8s_response_code AS code,\n       arrayStringConcat(k8s_source_ips, ', ') AS source_ips,\n       JSONExtractString(attributes, 'pod_security_violation') AS pod_security_violation\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND event_type = 'k8s.api.request'\n  AND k8s_response_code = 403\nORDER BY event_time DESC\nLIMIT 1 BY event_id\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
