            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT $__timeInterval(event_time) AS time,\n       concat(ifNull(k8s_namespace, '?'), '/', ifNull(k8s_pod_name, '?')) AS pod,\n       uniqExact(event_id) AS failures\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND source_type = 'k8s.container_log'\n  AND category = 'authentication' AND outcome IN ('failure', 'denied')\nGROUP BY time, pod\nORDER BY time, pod"
