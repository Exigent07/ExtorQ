    {
      "id": 8,
      "type": "timeseries",
      "title": "Workload authentication failures",
      "description": "Structured authentication failures in container logs (lab application).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
