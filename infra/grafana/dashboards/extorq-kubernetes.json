    {
      "id": 6,
      "type": "table",
      "title": "RBAC changes",
      "description": "Role/binding changes from the audit log and from inventory diffs with risk flags (K8S-002 inputs). risk_flags empty when none were computed.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT event_time, event_type, k8s_user AS user, k8s_verb AS verb,\n       ifNull(k8s_resource, resource_type) AS resource,\n       ifNull(k8s_namespace, resource_namespace) AS namespace,\n       ifNull(k8s_object_name, resource_name) AS object, k8s_response_code AS code, outcome,\n       arrayStringConcat(JSONExtract(attributes, 'risk_flags', 'Array(String)'), ', ')\n           AS risk_flags\nFROM extorq.events\nWHERE $__timeFilter(event_time)\n  AND ((event_type = 'k8s.api.request' AND k8s_resource IN ('roles', 'rolebindings', 'clusterroles', 'clusterrolebindings')\n        AND k8s_verb IN ('create', 'update', 'patch', 'delete'))\n       OR (event_type IN ('k8s.resource.created', 'k8s.resource.updated',\n                          'k8s.resource.deleted')\n           AND lower(ifNull(resource_type, '')) IN ('role', 'rolebinding', 'clusterrole',\n               'clusterrolebinding', 'roles', 'rolebindings', 'clusterroles', 'clusterrolebindings')))\nORDER BY event_time DESC\nLIMIT 1 BY event_id\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
