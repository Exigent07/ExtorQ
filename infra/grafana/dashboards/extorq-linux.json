      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT event_time, asset_id, event_type, actor_name AS user,\n       JSONExtractString(attributes, 'run_as') AS run_as, outcome,\n       process_command_line AS command\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND asset_type = 'linux_host'\n  AND event_type IN ('auth.sudo.command', 'auth.sudo.failure')\nORDER BY event_time DESC\nLIMIT 1 BY event_id\nLIMIT 200"
