    {
      "id": 4,
      "type": "table",
      "title": "SSH failure sources",
      "description": "Per source: distinct failure events, distinct (src_ip, src_port) connections (VM-001 counts connections) and attempted user names.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT asset_id, ifNull(src_ip, 'unknown') AS source_ip, uniqExact(event_id) AS failures,\n       uniqExact(tuple(src_ip, src_port)) AS connections, uniqExact(actor_name) AS users,\n       min(event_time) AS first_seen, max(event_time) AS last_seen\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND asset_type = 'linux_host'\n  AND event_type IN ('auth.ssh.login_failed', 'auth.ssh.invalid_user', 'auth.ssh.preauth_closed', 'auth.ssh.max_auth_exceeded')\nGROUP BY asset_id, source_ip\nORDER BY failures DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
