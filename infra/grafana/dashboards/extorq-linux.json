    {
      "id": 2,
      "type": "timeseries",
      "title": "SSH authentication failures by source IP",
      "description": "Failed, invalid-user, pre-auth-closed and max-auth-exceeded sshd events (VM-001 inputs).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT $__timeInterval(event_time) AS time, ifNull(src_ip, 'unknown') AS source_ip,\n       uniqExact(event_id) AS failures\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND asset_type = 'linux_host'\n  AND event_type IN ('auth.ssh.login_failed', 'auth.ssh.invalid_user', 'auth.ssh.preauth_closed', 'auth.ssh.max_auth_exceeded')\nGROUP BY time, source_ip\nORDER BY time, source_ip"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
