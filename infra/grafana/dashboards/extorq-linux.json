      "description": "Coverage: unsupported = no adapter; planned = extension point only, no telemetry; unmonitored = adapter not enabled; degraded = stale/failing (also when the discovery record is older than 1 h); monitored = enabled and fresh. The console/API also checks collector staleness per telemetry source. Endpoint attribution: confirmed (socket owner observed), inferred (configuration/well-known port), unknown.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 61
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT asset_id, name AS service, service_kind AS kind, category, product,\n       adapter_id AS adapter, adapter_support, monitoring_status,\n       multiIf(adapter_support = 'none', 'unsupported', adapter_support = 'planned', 'planned', monitoring_status = 'unmonitored', 'unmonitored', monitoring_status = 'degraded', 'degraded', last_seen < now() - INTERVAL 1 HOUR, 'degraded (stale record)', 'monitored') AS coverage, arrayStringConcat(arrayMap(e -> concat(JSONExtractString(e, 'protocol'), '/', toString(JSONExtractUInt(e, 'port')), ' ', JSONExtractString(e, 'exposure'), ' (', JSONExtractString(e, 'attribution'), ')'), JSONExtractArrayRaw(endpoints)), ', ') AS endpoints,\n       arrayStringConcat(telemetry_sources, ', ') AS telemetry_sources,\n       instance_count, last_seen AS discovery_refreshed, coverage_note\nFROM extorq.v_services\nWHERE present = 1\n  AND asset_id IN (SELECT asset_id FROM extorq.v_assets WHERE asset_type = 'linux_host')\nORDER BY asset_id, coverage, name\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
