    {
      "id": 9,
      "type": "table",
      "title": "systemd persistence changes",
      "description": "Unit created/modified/deleted/enabled (inventory diff) and auditd watches on systemd paths (VM-002 inputs).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT event_time, asset_id, event_type, resource_name AS unit, resource_path AS path,\n       JSONExtractString(attributes, 'sha256') AS sha256,\n       JSONExtractString(attributes, 'exec_start') AS exec_start, source_type\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND asset_type = 'linux_host'\n  AND (event_type IN ('persistence.systemd.unit_created', 'persistence.systemd.unit_modified', 'persistence.systemd.unit_deleted', 'persistence.systemd.unit_enabled')\n       OR (event_type = 'file.audit.watch'\n           AND JSONExtractString(attributes, 'audit_key') = 'extorq_systemd'))\nORDER BY event_time DESC\nLIMIT 1 BY event_id\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
