          "pluginVersion": "4.23.5",
          "rawSql": "SELECT uniqExact(event_id) AS logins\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND asset_type = 'linux_host'\n  AND event_type = 'auth.ssh.login_succeeded'"
