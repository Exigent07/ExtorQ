    {
      "id": 13,
      "type": "table",
      "title": "Route probing: routes with client errors",
      "description": "Routes requested in the range (route text is attacker-controlled).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT http_route AS route, uniqExact(event_id) AS requests,\n       uniqExactIf(event_id, http_status >= 400 AND http_status < 500) AS client_errors,\n       uniqExact(src_ip) AS sources, max(event_time) AS last_seen\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND asset_type = 'linux_host'\n  AND event_type = 'http.request'\nGROUP BY route\nORDER BY client_errors DESC, requests DESC\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
