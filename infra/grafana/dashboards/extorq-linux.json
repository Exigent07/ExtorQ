    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP responses by status class",
      "description": "Requests seen by the web server/application per HTTP status class.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT $__timeInterval(event_time) AS time,\n       if(http_status IS NULL, 'unknown', concat(toString(intDiv(http_status, 100)), 'xx'))\n           AS status_class,\n       uniqExact(event_id) AS requests\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND asset_type = 'linux_host'\n  AND event_type = 'http.request'\nGROUP BY time, status_class\nORDER BY time, status_class"
        }
      ],
      "fieldConfig": {
