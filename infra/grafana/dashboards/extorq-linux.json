    {
      "id": 7,
      "type": "table",
      "title": "sudo commands",
      "description": "sudo commands and failures. Command lines are redacted at ingestion for known secret patterns; treat them as sensitive.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
