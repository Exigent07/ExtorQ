    {
      "id": 14,
      "type": "table",
      "title": "Recent alerts",
      "description": "Latest alert versions with analyst workflow state (new when no analyst acted). Investigate in the ExtorQ console.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
