    {
      "id": 14,
      "type": "table",
      "title": "Recent alerts",
      "description": "Latest version of each alert active in the range, with the analyst workflow state (new when no analyst acted). Source: v_alerts (detector) and v_analyst_state (console). Confidence is evidence completeness, not a verdict. Investigate in the ExtorQ console.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT a.last_seen AS last_seen, a.rule_id AS rule_id, a.rule_title AS rule_title,\n       a.severity AS severity, a.confidence AS confidence, if(ifNull(n.n_name, '') = '', a.asset_id, n.n_name) AS asset,\n       if(ifNull(s.status, '') = '', 'new', s.status) AS analyst_status,\n       a.event_count AS events, a.summary AS summary, a.asset_id AS asset_id\nFROM extorq.v_alerts AS a\nLEFT JOIN\n(\n    SELECT alert_id, status FROM extorq.v_analyst_state\n) AS s ON s.alert_id = a.alert_id\nLEFT JOIN (SELECT asset_id AS n_asset_id, name AS n_name FROM extorq.v_assets) AS n ON n.n_asset_id = a.asset_id\nWHERE $__timeFilter(a.last_seen)\nORDER BY a.last_seen DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
