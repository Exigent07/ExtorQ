    {
      "id": 16,
      "type": "bargauge",
      "title": "Services by coverage state",
      "description": "Current state: present services by effective coverage. Source: v_services (one row per service, FINAL; reported by host and Kubernetes service discovery). Coverage: unsupported = no adapter; planned = extension point only, no telemetry; unmonitored = adapter not enabled; degraded = stale/failing (also when the discovery record is older than 1 h); monitored = enabled and fresh. The console/API also checks collector staleness per telemetry source.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT coverage, count() AS services\nFROM\n(\n    SELECT multiIf(adapter_support = 'none', 'unsupported', adapter_support = 'planned', 'planned', monitoring_status = 'unmonitored', 'unmonitored', monitoring_status = 'degraded', 'degraded', last_seen < now() - INTERVAL 1 HOUR, 'degraded (stale record)', 'monitored') AS coverage\n    FROM extorq.v_services\n    WHERE present = 1\n)\nGROUP BY coverage\nORDER BY coverage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
