    {
      "id": 17,
      "type": "table",
      "title": "Services by asset, kind and coverage",
      "description": "Current state: present services per asset, kind and coverage. Source: v_services joined to v_assets. A Kubernetes Service (k8s_service) is never a host OS service. Coverage: unsupported = no adapter; planned = extension point only, no telemetry; unmonitored = adapter not enabled; degraded = stale/failing (also when the discovery record is older than 1 h); monitored = enabled and fresh. The console/API also checks collector staleness per telemetry source.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT if(ifNull(n.n_name, '') = '', v.v_asset_id, n.n_name) AS asset, v.v_kind AS service_kind, v.v_coverage AS coverage,\n       v.services AS services, v.v_asset_id AS asset_id\nFROM\n(\n    SELECT asset_id AS v_asset_id, service_kind AS v_kind, multiIf(adapter_support = 'none', 'unsupported', adapter_support = 'planned', 'planned', monitoring_status = 'unmonitored', 'unmonitored', monitoring_status = 'degraded', 'degraded', last_seen < now() - INTERVAL 1 HOUR, 'degraded (stale record)', 'monitored') AS v_coverage,\n           count() AS services\n    FROM extorq.v_services\n    WHERE present = 1\n    GROUP BY v_asset_id, v_kind, v_coverage\n) AS v\nLEFT JOIN (SELECT asset_id AS n_asset_id, name AS n_name FROM extorq.v_assets) AS n ON n.n_asset_id = v.v_asset_id\nORDER BY asset, service_kind, coverage\nLIMIT 500"
        }
      ],
