    {
      "id": 6,
      "type": "timeseries",
      "title": "Event volume by source type",
      "description": "Distinct events per interval by telemetry source (e.g. linux.journald, k8s.audit, github.api, macos.unified_log). Source: extorq.events. A gap means nothing was stored, which is not proof of zero activity when collection was unhealthy.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT $__timeInterval(event_time) AS time, source_type, uniqExact(event_id) AS events\nFROM extorq.events\nWHERE $__timeFilter(event_time)\nGROUP BY time, source_type\nORDER BY time, source_type"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
