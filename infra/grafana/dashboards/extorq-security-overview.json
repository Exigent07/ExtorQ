      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT a.last_seen AS last_seen, a.rule_id AS rule_id, a.severity AS severity,\n       a.confidence AS confidence, a.asset_id AS asset_id,\n       if(ifNull(s.status, '') = '', 'new', s.status) AS analyst_status,\n       a.event_count AS events, a.summary AS summary\nFROM extorq.v_alerts AS a\nLEFT JOIN\n(\n    SELECT alert_id, status FROM extorq.v_analyst_state\n) AS s ON s.alert_id = a.alert_id\nWHERE $__timeFilter(a.last_seen)\nORDER BY a.last_seen DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
