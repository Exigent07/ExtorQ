    {
      "id": 11,
      "type": "table",
      "title": "Open findings by asset and scanner (current)",
      "description": "Current state, not time-filtered: open findings per asset (inventory name), scanner and severity. Source: v_findings_current joined to v_assets for the name.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT if(ifNull(n.n_name, '') = '', f.f_asset_id, n.n_name) AS asset, f.f_scanner AS scanner, f.f_severity AS severity,\n       f.findings AS findings, f.f_asset_id AS asset_id\nFROM\n(\n    SELECT asset_id AS f_asset_id, scanner AS f_scanner, severity AS f_severity,\n           uniqExact(finding_id) AS findings\n    FROM extorq.v_findings_current\n    WHERE state = 'open'\n    GROUP BY f_asset_id, f_scanner, f_severity\n) AS f\nLEFT JOIN (SELECT asset_id AS n_asset_id, name AS n_name FROM extorq.v_assets) AS n ON n.n_asset_id = f.f_asset_id\nORDER BY asset, scanner, multiIf(severity = 'critical', 4, severity = 'high', 3, severity = 'medium', 2, severity = 'low', 1, 0) DESC\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "high": {
                        "color": "red",
                        "index": 1
                      },
                      "medium": {
                        "color": "orange",
                        "index": 2
                      },
                      "low": {
                        "color": "yellow",
                        "index": 3
                      },
                      "info": {
                        "color": "blue",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Events by asset and source",
      "description": "Distinct events per asset and telemetry source in the range, with the newest event and ingestion times. Source: extorq.events joined to v_assets for the name. A source whose last event is old is quiet or failing: compare with collector health.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT if(ifNull(n.n_name, '') = '', e.e_asset_id, n.n_name) AS asset, e.e_asset_type AS asset_type,\n       e.e_source_type AS source_type, e.events AS events, e.last_event AS last_event_time,\n       e.last_ingested AS last_ingested_time, e.e_asset_id AS asset_id\nFROM\n(\n    SELECT asset_id AS e_asset_id, any(asset_type) AS e_asset_type,\n           source_type AS e_source_type, uniqExact(event_id) AS events,\n           max(event_time) AS last_event, max(ingested_time) AS last_ingested\n    FROM extorq.events\n    WHERE $__timeFilter(event_time)\n    GROUP BY e_asset_id, e_source_type\n) AS e\nLEFT JOIN (SELECT asset_id AS n_asset_id, name AS n_name FROM extorq.v_assets) AS n ON n.n_asset_id = e.e_asset_id\nORDER BY asset, source_type\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
