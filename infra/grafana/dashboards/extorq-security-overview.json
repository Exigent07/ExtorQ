    {
      "id": 10,
      "type": "bargauge",
      "title": "Open findings by severity (current)",
      "description": "Current state, not time-filtered: open findings per severity across all assets. Source: v_findings_current (scanner and posture results tied to their scan runs).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT severity, uniqExact(finding_id) AS findings\nFROM extorq.v_findings_current\nWHERE state = 'open'\nGROUP BY severity\nORDER BY multiIf(severity = 'critical', 4, severity = 'high', 3, severity = 'medium', 2, severity = 'low', 1, 0) DESC"
        }
      ],
      "fieldConfig": {
