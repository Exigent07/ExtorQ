      "type": "timeseries",
      "title": "Alerts by rule",
      "description": "Distinct alerts per interval of first_seen, by detection rule (id and title). Source: v_alerts (detector). Rule logic, false positives and blind spots: docs/detection-catalog.md.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
