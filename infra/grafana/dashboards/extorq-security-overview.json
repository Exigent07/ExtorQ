      "id": 2,
      "type": "stat",
      "title": "Events",
      "description": "Distinct normalised security events whose event_time falls in the selected range, across every asset. Source: extorq.events (all collectors through the ingest gateway). Volume only: a high or low number is neither good nor bad by itself.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
