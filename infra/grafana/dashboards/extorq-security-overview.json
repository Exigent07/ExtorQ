          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT $__timeInterval(first_seen) AS time, concat(rule_id, ' ', rule_title) AS rule,\n       uniqExact(alert_id) AS alerts\nFROM extorq.v_alerts\nWHERE $__timeFilter(first_seen)\nGROUP BY time, rule\nORDER BY time, rule"
