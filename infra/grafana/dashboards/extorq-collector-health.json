                    "type": "value",
                    "options": {
                      "monitored": {
                        "color": "green",
                        "index": 0
                      },
                      "degraded": {
                        "color": "orange",
                        "index": 1
                      },
                      "degraded (stale record)": {
                        "color": "orange",
                        "index": 2
                      },
                      "unmonitored": {
                        "color": "orange",
                        "index": 3
                      },
                      "planned": {
