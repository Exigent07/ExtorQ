    {
      "id": 2,
      "type": "table",
      "title": "Collectors: last success and staleness",
      "description": "Current state from v_collector_latest (latest report per collector, not time-filtered). STALE: no success for more than 3 x the collector interval.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT collector_id, collector_type, asset_id, status,\n       multiIf(last_success_at IS NULL, 'never succeeded',\n               interval_seconds = 0, 'no interval reported',\n               dateDiff('second', last_success_at, now()) > 3 * interval_seconds, 'STALE',\n               'fresh') AS freshness,\n       last_success_at,\n       dateDiff('second', last_success_at, now()) AS seconds_since_success,\n       interval_seconds, lag_seconds, records_buffered, events_collected,\n       last_reported_at, last_error\nFROM extorq.v_collector_latest\nORDER BY asset_id, collector_id\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "freshness",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Collector lag",
      "description": "Lag reported by each collector (seconds behind its source).",
      "datasource": {
