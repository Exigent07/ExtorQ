    {
      "id": 10,
      "type": "table",
      "title": "Pipeline components (latest report)",
      "description": "Current state, not time-filtered: the latest report of each gateway, writer, detector and ai-worker instance. Source: v_pipeline_latest. Counters are totals since the instance started; an old report_age means the instance stopped reporting (for example replaced by a newer container).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT component, instance, status, last_reported_at,\n       dateDiff('second', last_reported_at, now()) AS report_age_seconds,\n       queue_depth, accepted_total, duplicate_total, rejected_total, quarantined_total,\n       written_total, write_errors_total, dead_letter_total, last_write_at\nFROM extorq.v_pipeline_latest\nORDER BY component, instance\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
