    {
      "id": 18,
      "type": "table",
      "title": "Monitored services: telemetry freshness",
      "description": "Coverage: unsupported = no adapter; planned = extension point only, no telemetry; unmonitored = adapter not enabled; degraded = stale/failing (also when the discovery record is older than 1 h); monitored = enabled and fresh. The console/API also checks collector staleness per telemetry source. Events are those attributed to the service by its adapter.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 62
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT s.asset_id AS asset_id, s.name AS service, s.service_kind AS kind,\n       s.adapter_id AS adapter, multiIf(s.adapter_support = 'none', 'unsupported', s.adapter_support = 'planned', 'planned', s.monitoring_status = 'unmonitored', 'unmonitored', s.monitoring_status = 'degraded', 'degraded', s.last_seen < now() - INTERVAL 1 HOUR, 'degraded (stale record)', 'monitored') AS coverage,\n       s.last_seen AS discovery_refreshed, e.last_event_time AS last_attributed_event,\n       ifNull(e.events, 0) AS events_in_range\nFROM extorq.v_services AS s\nLEFT JOIN\n(\n    SELECT assumeNotNull(service_id) AS sid, max(event_time) AS last_event_time,\n           uniqExact(event_id) AS events\n    FROM extorq.events\n    WHERE $__timeFilter(event_time) AND service_id IS NOT NULL\n    GROUP BY sid\n) AS e ON e.sid = s.service_id\nWHERE s.present = 1 AND s.adapter_support = 'implemented'\nORDER BY s.asset_id, s.name\nLIMIT 500"
        }
      ],
