    {
      "id": 2,
      "type": "table",
      "title": "Collectors: last success and staleness",
      "description": "Current state, not time-filtered: the latest health report of every collector. Source: v_collector_latest (collector SDK and OpenTelemetry delivery reports). STALE: no successful collection for more than 3 x its interval. SDK collectors report records buffered in their outbox. The OpenTelemetry panel reports its queue separately in exporter requests.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT c.collector_id AS collector_id, c.collector_type AS collector_type,\n       if(ifNull(n.n_name, '') = '', c.asset_id, n.n_name) AS asset, c.status AS status,\n       multiIf(c.last_success_at IS NULL, 'never succeeded',\n               c.interval_seconds = 0, 'no interval reported',\n               dateDiff('second', c.last_success_at, now()) > 3 * c.interval_seconds, 'STALE',\n               'fresh') AS freshness,\n       c.last_success_at AS last_success_at,\n       dateDiff('second', c.last_success_at, now()) AS seconds_since_success,\n       c.interval_seconds AS interval_seconds, c.lag_seconds AS lag_seconds,\n       if(c.collector_type = 'k8s_otel', NULL, c.records_buffered) AS records_buffered,\n       c.events_collected AS events_collected,\n       c.last_reported_at AS last_reported_at, c.last_error AS last_error,\n       c.asset_id AS asset_id\nFROM extorq.v_collector_latest AS c\nLEFT JOIN (SELECT asset_id AS n_asset_id, name AS n_name FROM extorq.v_assets) AS n ON n.n_asset_id = c.asset_id\nORDER BY asset, collector_id\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "degraded": {
                        "color": "orange",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "freshness"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "fresh": {
                        "color": "green",
                        "index": 0
                      },
                      "STALE": {
                        "color": "red",
                        "index": 1
                      },
                      "never succeeded": {
                        "color": "red",
                        "index": 2
                      },
                      "no interval reported": {
                        "color": "orange",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "seconds_since_success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "interval_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lag_seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "freshness",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Kubernetes OpenTelemetry delivery by node and source",
      "description": "Current reported delivery for each node and source. Source: v_collector_latest (OpenTelemetry reporter). A report older than three intervals is unavailable. Queue and exporter counts are shared on the node and must not be summed across sources. Record counters are cumulative since the Collector started. Blank values indicate unavailable measurements.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT if(ifNull(n.n_name, '') = '', c.asset_id, n.n_name) AS node, c.source_types AS sources,\n       multiIf(dateDiff('second', c.last_reported_at, now()) > 3 * c.interval_seconds,\n               'unavailable',\n               JSONExtractString(c.details, 'delivery_state') IN\n                   ('delivering', 'running_not_delivering', 'degraded', 'backlogged',\n                    'dropping_records', 'unavailable'),\n               JSONExtractString(c.details, 'delivery_state'), 'unknown') AS delivery_state,\n       JSONExtract(c.details, 'queue_requests', 'Nullable(UInt64)') AS queue_requests,\n       JSONExtract(c.details, 'queue_capacity_requests', 'Nullable(UInt64)') AS queue_capacity,\n       JSONExtract(c.details, 'accepted_records', 'Nullable(UInt64)') AS accepted_records,\n       JSONExtract(c.details, 'sent_records', 'Nullable(UInt64)') AS exporter_sent_records,\n       JSONExtract(c.details, 'send_failed_records', 'Nullable(UInt64)') AS exporter_send_failures,\n       JSONExtract(c.details, 'enqueue_failed_records', 'Nullable(UInt64)')\n           AS exporter_enqueue_failures,\n       c.last_success_at AS last_delivery, c.last_reported_at AS last_report, c.asset_id AS asset_id\nFROM extorq.v_collector_latest AS c\nLEFT JOIN (SELECT asset_id AS n_asset_id, name AS n_name FROM extorq.v_assets) AS n ON n.n_asset_id = c.asset_id\nWHERE c.collector_type = 'k8s_otel'\nORDER BY node, sources\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "delivery_state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "delivering": {
                        "color": "green",
                        "index": 0
                      },
                      "running_not_delivering": {
                        "color": "orange",
                        "index": 1
                      },
                      "degraded": {
                        "color": "orange",
                        "index": 2
                      },
                      "backlogged": {
                        "color": "orange",
                        "index": 3
                      },
                      "dropping_records": {
                        "color": "red",
                        "index": 4
                      },
                      "unavailable": {
                        "color": "red",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Collector lag",
      "description": "How far each collector is behind its source (seconds), as it reports it. Source: extorq.collector_health. Dashed lines: 5 min (attention) and 15 min (detections run on late data). Collectors that do not report lag are absent.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT $__timeInterval(reported_at) AS time, collector_id, max(lag_seconds) AS max_lag_seconds\nFROM extorq.collector_health\nWHERE $__timeFilter(reported_at) AND lag_seconds IS NOT NULL\nGROUP BY time, collector_id\nORDER BY time, collector_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
