    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingestion lag p95 (event time to ingestion)",
      "description": "95th percentile of (first ingestion - event_time) per telemetry source, one sample per distinct event. Source: extorq.events. Includes collector polling intervals and source clock skew. Dashed lines: 2 min and 10 min.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT $__timeInterval(ingested) AS time, e_source_type AS source_type,\n       quantileExact(0.95)(greatest(dateDiff('millisecond', evt, ingested), 0)) / 1000\n           AS p95_lag_seconds\nFROM\n(\n    SELECT event_id, any(source_type) AS e_source_type, any(event_time) AS evt,\n           min(ingested_time) AS ingested\n    FROM extorq.events\n    WHERE $__timeFilter(ingested_time)\n    GROUP BY event_id\n)\nGROUP BY time, source_type\nORDER BY time, source_type"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
