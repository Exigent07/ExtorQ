    {
      "id": 12,
      "type": "table",
      "title": "Rules: latest run",
      "description": "Current state, not time-filtered: the latest run of every detection rule. Sources: v_rule_latest_run (written by the detector) and detection_rules (titles). missing_sources lists required telemetry with no data in the last window: the rule is blind there, which is a coverage signal, not a failure.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 52
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT r.rule_id AS rule_id, ifNull(d.d_title, '') AS title, r.rule_version AS rule_version,\n       r.last_run_at AS last_run_at, r.last_status AS last_status, r.runs_24h AS runs_24h,\n       r.failures_24h AS failures_24h, r.last_duration_ms AS last_duration_ms,\n       arrayStringConcat(r.missing_sources, ', ') AS missing_sources, r.last_error AS last_error\nFROM extorq.v_rule_latest_run AS r\nLEFT JOIN\n(\n    SELECT rule_id AS d_rule_id, argMax(title, loaded_at) AS d_title\n    FROM extorq.detection_rules\n    GROUP BY d_rule_id\n) AS d ON d.d_rule_id = r.rule_id\nORDER BY rule_id\nLIMIT 200"
        }
      ],
