    {
      "id": 19,
      "type": "table",
      "title": "Monitored services: telemetry freshness",
      "description": "Services with an implemented adapter: when discovery last refreshed them and their newest attributed event in the range. Sources: v_services and extorq.events (events the adapter attributed to the service). A quiet service is not necessarily broken. Coverage: unsupported = no adapter; planned = extension point only, no telemetry; unmonitored = adapter not enabled; degraded = stale/failing (also when the discovery record is older than 1 h); monitored = enabled and fresh. The console/API also checks collector staleness per telemetry source.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 70
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT if(ifNull(n.n_name, '') = '', s.asset_id, n.n_name) AS asset, s.name AS service, s.service_kind AS kind,\n       s.adapter_id AS adapter, multiIf(s.adapter_support = 'none', 'unsupported', s.adapter_support = 'planned', 'planned', s.monitoring_status = 'unmonitored', 'unmonitored', s.monitoring_status = 'degraded', 'degraded', s.last_seen < now() - INTERVAL 1 HOUR, 'degraded (stale record)', 'monitored') AS coverage,\n       s.last_seen AS discovery_refreshed, e.last_event_time AS last_attributed_event,\n       ifNull(e.events, 0) AS events_in_range, s.asset_id AS asset_id\nFROM extorq.v_services AS s\nLEFT JOIN\n(\n    SELECT assumeNotNull(service_id) AS sid, max(event_time) AS last_event_time,\n           uniqExact(event_id) AS events\n    FROM extorq.events\n    WHERE $__timeFilter(event_time) AND service_id IS NOT NULL\n    GROUP BY sid\n) AS e ON e.sid = s.service_id\nLEFT JOIN (SELECT asset_id AS n_asset_id, name AS n_name FROM extorq.v_assets) AS n ON n.n_asset_id = s.asset_id\nWHERE s.present = 1 AND s.adapter_support = 'implemented'\nORDER BY asset, service\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
