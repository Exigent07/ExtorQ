{
  "uid": "extorq-github",
  "title": "ExtorQ - GitHub Investigation",
  "description": "GitHub repositories: commits, workflow changes with permission and trigger deltas, credential-shaped strings in commits (redacted), workflow runs, settings changes and repository findings. Source: github.api (GitHub collector, read-only API polling). Commit and workflow text is attacker-controllable.",
  "tags": [
    "extorq"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "ExtorQ dashboards",
      "tags": [
        "extorq"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Activity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Commits by repository",
      "description": "Commits observed by the GitHub collector per repository (time = commit time as GitHub reports it). Source: github.api.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT $__timeInterval(event_time) AS time, ifNull(gh_repository, 'unknown') AS repository,\n       uniqExact(event_id) AS commits\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND event_type = 'github.commit.observed'\nGROUP BY time, repository\nORDER BY time, repository"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Workflow runs by conclusion",
      "description": "Observed GitHub Actions workflow runs per conclusion (success, failure, cancelled, pending). Source: github.api.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT $__timeInterval(event_time) AS time, ifNull(gh_conclusion, 'pending/unknown')\n           AS conclusion,\n       uniqExact(event_id) AS runs\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND event_type = 'github.workflow_run.observed'\nGROUP BY time, conclusion\nORDER BY time, conclusion"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Workflow and commit security",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "Workflow modifications and permission deltas",
      "description": "Every commit that changed a workflow, with the permission analysis before/after: write-all added, added write scopes, dangerous triggers (pull_request_target) and risk flags such as untrusted checkout, unpinned third-party actions or untrusted context in run steps (GH-001 to GH-004 inputs). Source: github.api.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT event_time, gh_repository AS repository, gh_workflow_path AS workflow,\n       gh_commit_sha AS commit, gh_actor_login AS actor,\n       multiIf(JSONType(attributes, 'write_all_added') != 'Bool', 'not reported', JSONExtractBool(attributes, 'write_all_added'), 'YES', 'no') AS write_all_added,\n       arrayStringConcat(JSONExtract(attributes, 'added_write_scopes', 'Array(String)'), ', ') AS added_write_scopes,\n       arrayStringConcat(JSONExtract(attributes, 'triggers_added', 'Array(String)'), ', ') AS triggers_added,\n       arrayStringConcat(JSONExtract(attributes, 'risk_flags', 'Array(String)'), ', ') AS risk_flags\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND event_type = 'github.workflow.modified'\nORDER BY event_time DESC\nLIMIT 1 BY event_id\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "write_all_added"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "YES": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Credential-shaped strings committed (redacted)",
      "description": "Commits that added a string matching a credential pattern (GH-005 inputs). Source: github.api. Only the pattern name, file, line and a redacted match are stored, never the value. Gitleaks findings on the repository are under Findings.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT event_time, gh_repository AS repository, gh_commit_sha AS commit,\n       gh_actor_login AS actor, resource_path AS path,\n       JSONExtractString(attributes, 'pattern') AS pattern,\n       JSONExtractString(attributes, 'line') AS line,\n       JSONExtractString(attributes, 'redacted_match') AS redacted_match\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND event_type = 'github.secret.exposed'\nORDER BY event_time DESC\nLIMIT 1 BY event_id\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent workflow runs",
      "description": "Latest workflow runs with their trigger event and conclusion. Source: github.api.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT event_time, gh_repository AS repository, gh_workflow_path AS workflow,\n       gh_workflow_run_id AS run_id, gh_event_name AS trigger, gh_conclusion AS conclusion,\n       gh_actor_login AS actor, gh_commit_sha AS commit\nFROM extorq.events\nWHERE $__timeFilter(event_time) AND event_type = 'github.workflow_run.observed'\nORDER BY event_time DESC\nLIMIT 1 BY event_id\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
