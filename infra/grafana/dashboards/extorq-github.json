    {
      "id": 10,
      "type": "table",
      "title": "Repository findings",
      "description": "Current state, not time-filtered: open = seen by the latest succeeded scan; unverified = presence cannot be confirmed (failed or partial scan). Source: v_findings_current (Gitleaks, Semgrep, Trivy and repository posture checks).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT replaceRegexpOne(asset_id, '^[a-z0-9]+:', '') AS repository, scanner, severity, state, check_id, title,\n       resource_path AS path, last_observed_at, latest_scan_status\nFROM extorq.v_findings_current\nWHERE startsWith(asset_id, 'github:') AND state IN ('open', 'unverified')\nORDER BY multiIf(severity = 'critical', 4, severity = 'high', 3, severity = 'medium', 2, severity = 'low', 1, 0) DESC, last_observed_at DESC\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "high": {
                        "color": "red",
                        "index": 1
                      },
                      "medium": {
                        "color": "orange",
                        "index": 2
                      },
                      "low": {
                        "color": "yellow",
                        "index": 3
                      },
                      "info": {
                        "color": "blue",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "open": {
                        "color": "red",
                        "index": 0
                      },
                      "unverified": {
                        "color": "orange",
                        "index": 1
                      },
                      "resolved": {
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Open findings by scanner",
      "description": "Current state, not time-filtered: open repository findings per scanner. Source: v_findings_current.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT scanner, uniqExact(finding_id) AS findings\nFROM extorq.v_findings_current\nWHERE startsWith(asset_id, 'github:') AND state = 'open'\nGROUP BY scanner\nORDER BY findings DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      }
    }
  ]
