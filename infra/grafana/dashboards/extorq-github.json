            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Repository setting changes",
      "description": "Repository settings and branch protection changes detected between polls. Source: github.api. Organisation audit logs are not available to the collector.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "extorq-clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "extorq-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.23.5",
          "rawSql": "SELECT event_time, gh_repository AS repository, event_type, gh_actor_login AS actor,\n       message\nFROM extorq.events\nWHERE $__timeFilter(event_time)\n  AND event_type IN ('github.repo.settings_changed', 'github.branch_protection.changed')\nORDER BY event_time DESC\nLIMIT 1 BY event_id\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
