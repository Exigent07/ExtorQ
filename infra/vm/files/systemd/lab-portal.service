# ExtorQ lab portal (deployed by cloud-init from infra/vm/files/systemd/lab-portal.service).
[Unit]
Description=ExtorQ lab portal (demo web application behind nginx)
Documentation=file:///opt/extorq/lab-portal/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /opt/extorq/lab-portal/app.py
Environment=LAB_PORTAL_HOST=127.0.0.1 LAB_PORTAL_PORT=8080 LOG_ACCESS=0
Environment=LAB_PORTAL_TRUSTED_PROXIES=127.0.0.1 LAB_PORTAL_DEMO_USER=lab-admin
LoadCredential=demo_password_hash:/etc/extorq/lab-portal/demo_password_hash
Environment=LAB_PORTAL_PASSWORD_HASH_FILE=%d/demo_password_hash
SyslogIdentifier=lab-portal
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=2

# Sandbox: dynamic unprivileged user, read-only OS, no new privileges.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
IPAddressDeny=any
IPAddressAllow=localhost
LimitNOFILE=1024
TasksMax=128
MemoryMax=256M

[Install]
WantedBy=multi-user.target
