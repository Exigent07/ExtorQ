    r"t=[0-9a-f]{1,16};x=[0-9a-f]{1,16}$"
)
_UINT_RE = re.compile(r"^(0|[1-9][0-9]{0,18})$")


class Denied(Exception):
    """The requested command is not on the allow-list (or malformed)."""


class DispatchFailure(Exception):
    """An allowed command failed; message is a short, non-sensitive summary."""


@dataclass(frozen=True)
class Command:
    name: str
    cursor: str | None = None
    max_entries: int = 0
    inode: int | None = None
    offset: int = 0
    max_bytes: int = 0


def _uint(token: str, low: int, high: int) -> int:
    if not _UINT_RE.match(token):
        raise Denied("not an unsigned integer")
    value = int(token)
    if not low <= value <= high:
        raise Denied("integer out of range")
    return value


def parse_command(raw: str | None) -> Command:
    """Strictly parse SSH_ORIGINAL_COMMAND into an allow-listed Command."""
    if raw is None or raw == "":
        raise Denied("no command (interactive sessions are not allowed)")
    if len(raw) > MAX_COMMAND_CHARS:
        raise Denied("command too long")
    if not _TOKEN_CHARS.match(raw):
        raise Denied("illegal characters or spacing")
    tokens = raw.split(" ")
    name = tokens[0]
    args = tokens[1:]
    if name in ("version", "inventory", "packages", "posture"):
        if args:
            raise Denied(f"{name} takes no arguments")
        return Command(name=name)
    if name == "journal":
        if len(args) != 2:
            raise Denied("usage: journal <cursor|-> <max_entries>")
        cursor = None
        if args[0] != "-":
            if not CURSOR_RE.match(args[0]):
                raise Denied("malformed journal cursor")
            cursor = args[0]
        return Command(name=name, cursor=cursor,
                       max_entries=_uint(args[1], 1, MAX_JOURNAL_ENTRIES))
    if name == "audit":
        if len(args) != 3:
            raise Denied("usage: audit <inode|-> <offset> <max_bytes>")
        inode = None if args[0] == "-" else _uint(args[0], 1, 2**64 - 1)
        return Command(name=name, inode=inode, offset=_uint(args[1], 0, 2**53),
                       max_bytes=_uint(args[2], MIN_AUDIT_BYTES, MAX_AUDIT_BYTES))
    raise Denied("unknown command")


# ── Helpers ────────────────────────────────────────────────────────────────────


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def emit_json(obj: object) -> None:
    sys.stdout.write(json.dumps(obj, ensure_ascii=True, separators=(",", ":"),
                                sort_keys=False, allow_nan=False))
    sys.stdout.write("\n")


def run_fixed(argv: list[str], timeout: float = SUBPROCESS_TIMEOUT,
              limit: int = MAX_SUBPROCESS_OUTPUT) -> tuple[int, bytes, bytes]:
    """Run a fixed argv (no shell) with a timeout and bounded stdout/stderr."""
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=SAFE_ENV, close_fds=True,
                                shell=False)
    except OSError as exc:
        raise DispatchFailure(f"cannot execute {os.path.basename(argv[0])}: {exc.strerror}") from None
    out = bytearray()
    err = bytearray()
    deadline = time.monotonic() + timeout
    sel = selectors.DefaultSelector()
    assert proc.stdout is not None and proc.stderr is not None
    sel.register(proc.stdout, selectors.EVENT_READ, out)
    sel.register(proc.stderr, selectors.EVENT_READ, err)
    try:
        while sel.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise DispatchFailure(f"{os.path.basename(argv[0])} timed out")
            for key, _ in sel.select(timeout=min(remaining, 1.0)):
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    sel.unregister(key.fileobj)
                    continue
                buf = key.data
                buf.extend(chunk)
                if len(out) > limit or len(err) > 65536:
                    raise DispatchFailure(f"{os.path.basename(argv[0])} output too large")
        rc = proc.wait(timeout=max(0.1, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        raise DispatchFailure(f"{os.path.basename(argv[0])} timed out") from None
    finally:
        sel.close()
        if proc.poll() is None:
            proc.kill()
            proc.wait()
        proc.stdout.close()
        proc.stderr.close()
    return rc, bytes(out), bytes(err)


def first_line(data: bytes, limit: int = 200) -> str:
    text = data.decode("utf-8", "replace").strip().splitlines()
    return text[0][:limit] if text else ""


def read_text(path: str, limit: int = 1024 * 1024) -> str | None:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        with os.fdopen(fd, "rb", closefd=False) as handle:
            return handle.read(limit).decode("utf-8", "replace")
    except OSError:
        return None
    finally:
        os.close(fd)


def file_facts(path: str, with_hash: bool = True) -> dict[str, object]:
    """Metadata (+ sha256 when readable) of a file, never following symlinks."""
    facts: dict[str, object] = {"path": path}
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        facts["exists"] = False
        return facts
    except OSError as exc:
        facts["exists"] = None
        facts["error"] = exc.strerror
        return facts
    facts.update({
        "exists": True,
        "mode": "%04o" % stat.S_IMODE(st.st_mode),
        "uid": st.st_uid,
        "gid": st.st_gid,
        "size": st.st_size,
        "mtime": int(st.st_mtime),
    })
    if stat.S_ISLNK(st.st_mode):
        facts["kind"] = "symlink"
        try:
            facts["symlink_target"] = os.readlink(path)[:1024]
        except OSError:
            facts["symlink_target"] = None
        return facts
    if not stat.S_ISREG(st.st_mode):
        facts["kind"] = "dir" if stat.S_ISDIR(st.st_mode) else "other"
        return facts
    facts["kind"] = "file"
    if not with_hash:
        return facts
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except PermissionError:
        facts["readable"] = False
        return facts
    except OSError as exc:
        facts["readable"] = False
        facts["error"] = exc.strerror
        return facts
    digest = hashlib.sha256()
    total = 0
    try:
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_FILE_HASH_BYTES:
                facts["readable"] = True
                facts["sha256"] = None
                facts["error"] = "too large to hash"
                return facts
            digest.update(chunk)
    except OSError as exc:
        facts["readable"] = False
        facts["error"] = exc.strerror
        return facts
    finally:
        os.close(fd)
    facts["readable"] = True
    facts["sha256"] = digest.hexdigest()
    return facts


def os_release() -> dict[str, str]:
    text = read_text("/etc/os-release") or read_text("/usr/lib/os-release") or ""
    result: dict[str, str] = {}
    for line in text.splitlines():
        key, sep, value = line.partition("=")
        if sep and key in OS_RELEASE_KEYS:
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            result[key] = value[:256]
    return result


def host_facts() -> dict[str, object]:
    uts = os.uname()
    uptime = None
    text = read_text("/proc/uptime")
    if text:
        try:
            uptime = float(text.split()[0])
        except (ValueError, IndexError):
            uptime = None
    boot_id = (read_text("/proc/sys/kernel/random/boot_id") or "").strip() or None
    btime = None
    for line in (read_text("/proc/stat", 64 * 1024) or "").splitlines():
        if line.startswith("btime "):
            try:
                btime = int(line.split()[1])
            except (IndexError, ValueError):
                btime = None
            break
    try:
        clk_tck = int(os.sysconf("SC_CLK_TCK"))
    except (ValueError, OSError):
        clk_tck = None
    return {
        "hostname": uts.nodename,
        "kernel_release": uts.release,
        "kernel_version": uts.version,
        "machine": uts.machine,
        "boot_id": boot_id,
        "uptime_seconds": uptime,
        # Boot time (epoch seconds) and clock ticks per second: process start times are
        # btime + start_ticks / clk_tck.
        "btime": btime,
        "clk_tck": clk_tck,
        "os_release": os_release(),
    }


# ── journal ────────────────────────────────────────────────────────────────────


def _journal_value(value: object, limit: int) -> str | None:
    if value is None:
        return None
    if isinstance(value, list):
        # Multiple values or a binary field (list of byte values).
        if value and all(isinstance(v, int) for v in value):
            return bytes(v & 0xFF for v in value[:limit * 4]).decode("utf-8", "replace")[:limit]
        value = value[0] if value else None
        if isinstance(value, list):
            return _journal_value(value, limit)
        if value is None:
            return None
    return str(value)[:limit]


def filter_journal_entry(entry: dict[str, object]) -> dict[str, str | None]:
    out: dict[str, str | None] = {}
    for field in JOURNAL_FIELDS:
        if field in entry:
            limit = MAX_MESSAGE_CHARS if field == "MESSAGE" else 512
            out[field] = _journal_value(entry[field], limit)
    return out


def cmd_journal(command: Command) -> int:
    # All journals readable by the collector (system + per-user): sudo and
    # post-authentication sshd lines are stored in the invoking user's journal,
    # so --system would silently drop them.
    argv = ["/usr/bin/journalctl", "--no-pager", "--quiet", "-o", "json",
            "--output-fields=" + ",".join(f for f in JOURNAL_FIELDS if not f.startswith("__"))]
    if command.cursor:
        # Inclusive seek: the first entry is dropped when it IS the checkpoint, which
        # proves the checkpoint still exists (no rotation/vacuum gap).
        argv.append("--cursor=" + command.cursor)
    else:
        argv.append("--since=" + JOURNAL_INITIAL_SINCE)
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=SAFE_ENV, close_fds=True)
    except OSError as exc:
        raise DispatchFailure(f"cannot execute journalctl: {exc.strerror}") from None
    assert proc.stdout is not None and proc.stderr is not None
    deadline = time.monotonic() + JOURNAL_TIMEOUT
    entries = 0
    written = 0
    malformed = 0
    oversized = 0
    truncated = False
    timed_out = False
    first = True
    cursor_exact: bool | None = None
    last_cursor: str | None = None
    try:
        for raw in proc.stdout:
            if time.monotonic() > deadline:
                timed_out = True
                truncated = True
                break
            if len(raw) > MAX_JOURNAL_LINE_BYTES:
                oversized += 1
                first = False
                continue
            try:
                entry = json.loads(raw)
            except ValueError:
                malformed += 1
                continue
            if not isinstance(entry, dict):
                malformed += 1
                continue
            if first:
                first = False
                if command.cursor:
                    if entry.get("__CURSOR") == command.cursor:
                        cursor_exact = True
                        continue
                    cursor_exact = False
            line = json.dumps(filter_journal_entry(entry), ensure_ascii=True,
                              separators=(",", ":"))
            sys.stdout.write(line + "\n")
            written += len(line) + 1
            entries += 1
            cursor = entry.get("__CURSOR")
            if isinstance(cursor, str):
                last_cursor = cursor
            if entries >= command.max_entries or written >= MAX_JOURNAL_OUTPUT_BYTES:
                truncated = True
                break
    finally:
        if proc.poll() is None:
            proc.kill()
        try:
            _, err = proc.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            _, err = proc.communicate()
    rc = proc.returncode
    if command.cursor and first:
        # Nothing at all was returned: the checkpoint entry itself is gone.
        cursor_exact = False
    error = None
    if rc not in (0, None, -9) and not truncated and entries == 0:
        error = first_line(err) or f"journalctl exited with status {rc}"
    emit_json({"_extorq": {
        "type": "journal_end",
        "protocol": PROTOCOL,
        "entries": entries,
        "truncated": truncated,
        "timed_out": timed_out,
        "cursor_requested": command.cursor is not None,
        "cursor_exact": cursor_exact,
        "last_cursor": last_cursor,
        "skipped_malformed": malformed,
        "skipped_oversized": oversized,
        "journalctl_exit": rc,
        "error": error,
        "since": None if command.cursor else JOURNAL_INITIAL_SINCE,
    }})
    return EXIT_OK


# ── audit ──────────────────────────────────────────────────────────────────────


def _audit_files() -> list[tuple[str, os.stat_result]]:
    """Existing audit log files ordered oldest -> newest (audit.log.N ... audit.log)."""
    files: list[tuple[str, os.stat_result]] = []
    for index in range(AUDIT_MAX_ROTATED, 0, -1):
        path = f"{AUDIT_LOG}.{index}"
        try:
            files.append((path, os.stat(path)))
        except OSError:
            continue
    try:
        files.append((AUDIT_LOG, os.stat(AUDIT_LOG)))
    except PermissionError:
        raise DispatchFailure("audit log not readable by the collector (log_group=adm?)") from None
    except OSError:
        raise DispatchFailure("audit log not found") from None
    return files


def plan_audit_read(files: list[tuple[str, int, int]], inode: int | None,
                    offset: int) -> tuple[int, int, bool, str | None]:
    """Decide which file (index into ``files``) and offset to read.

    ``files`` are (path, inode, size) ordered oldest -> newest; the last entry is
    the live audit.log. Returns (index, start_offset, gap, gap_reason).
    """
    current = len(files) - 1
    if inode is None:
        size = files[current][2]
        return current, (offset if offset <= size else 0), False, None
    for index, (_, file_inode, size) in enumerate(files):
        if file_inode != inode:
            continue
        if offset > size:
            # The file shrank under the checkpoint: truncated/rewritten.
            return index, 0, True, "file_truncated"
        while offset >= files[index][2] and index < current:
            index += 1  # rotated file fully consumed: continue with the next newer one
            offset = 0
        return index, offset, False, None
    # The checkpointed file rotated out of the retained set: data was lost.
    return current, 0, True, "rotated_past_offset"


def cmd_audit(command: Command) -> int:
    files_stat = _audit_files()
    files = [(path, st.st_ino, st.st_size) for path, st in files_stat]
    index, start, gap, gap_reason = plan_audit_read(files, command.inode, command.offset)
    path = files[index][0]
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except PermissionError:
        raise DispatchFailure("audit log not readable by the collector") from None
    except OSError:
        raise DispatchFailure("audit log disappeared during read") from None
    try:
        st = os.fstat(fd)
        if st.st_ino != files[index][1]:
            raise DispatchFailure("audit log rotated during read; retry")
        os.lseek(fd, start, os.SEEK_SET)
        data = b""
        while len(data) < command.max_bytes:
            chunk = os.read(fd, command.max_bytes - len(data))
            if not chunk:
                break
            data += chunk
    finally:
        os.close(fd)
    oversized_line = False
    cut = data.rfind(b"\n")
    if cut >= 0:
        payload = data[:cut + 1]
    elif len(data) >= command.max_bytes:
        payload = b""
        oversized_line = True  # a single line longer than max_bytes: skip it
    else:
        payload = b""  # partial line being written right now: retry next poll
    consumed = len(payload) if not oversized_line else len(data)
    next_offset = start + consumed
    current_inode, current_size = files[-1][1], files[-1][2]
    more = next_offset < st.st_size or index < len(files) - 1
    emit_json({"_extorq": {
        "type": "audit",
        "protocol": PROTOCOL,
        "file": os.path.basename(path),
        "inode": st.st_ino,
        "size": st.st_size,
        "start_offset": start,
        "next_offset": next_offset,
        "bytes": len(payload),
        "gap": gap,
        "gap_reason": gap_reason,
        "oversized_line_skipped": oversized_line,
        "more": more,
        "current_inode": current_inode,
        "current_size": current_size,
        "rotated_files": len(files) - 1,
    }})
    sys.stdout.flush()
    sys.stdout.buffer.write(payload)
    sys.stdout.buffer.flush()
    return EXIT_OK


# ── inventory ──────────────────────────────────────────────────────────────────


#: Unit directives reported verbatim (bounded). Environment=/EnvironmentFile= and every
#: other directive are deliberately NOT collected: they may carry credentials.
UNIT_DIRECTIVES = ("Type", "User", "Group", "DynamicUser", "Service", "ListenStream",
                   "ListenDatagram", "WantedBy")


def _unit_details(path: str) -> dict[str, object]:
    text = read_text(path, limit=256 * 1024)
    if text is None:
        return {}
    exec_start: list[str] = []
    description = None
    directives: dict[str, list[str]] = {}
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("ExecStart=") and len(exec_start) < 4:
            declared = stripped[len("ExecStart="):].lstrip().lstrip("-@:+!").split(maxsplit=1)
            if declared and len(declared[0]) <= MAX_EXEC_CHARS and re.fullmatch(
                r"/[A-Za-z0-9._%+@/-]+", declared[0]
            ):
                exec_start.append(declared[0])
        elif stripped.startswith("Description=") and description is None:
            description = stripped[len("Description="):][:256]
        else:
            key, sep, value = stripped.partition("=")
            key = key.strip()
            if sep and key in UNIT_DIRECTIVES:
                values = directives.setdefault(key, [])
                if len(values) < 8:
                    values.append(value.strip()[:256])
    return {"exec_start": exec_start, "description": description, "directives": directives}


def collect_units() -> tuple[list[dict[str, object]], list[dict[str, object]], bool]:
    units: list[dict[str, object]] = []
    enablement: list[dict[str, object]] = []
    seen_real: set[str] = set()
    truncated = False
    for unit_dir in UNIT_DIRS:
        try:
            real = os.path.realpath(unit_dir)
        except OSError:
            continue
        if real in seen_real or not os.path.isdir(unit_dir):
            continue
        seen_real.add(real)
        try:
            names = sorted(os.listdir(unit_dir))
        except OSError:
            units.append({"path": unit_dir, "kind": "dir", "readable": False})
            continue
        for name in names:
            if len(units) >= MAX_UNITS:
                truncated = True
                break
            path = os.path.join(unit_dir, name)
            if name.endswith((".wants", ".requires", ".upholds")) and os.path.isdir(path):
                relation = name.rsplit(".", 1)[1]
                target = name[: -(len(relation) + 1)]
                try:
                    links = sorted(os.listdir(path))
                except OSError:
                    continue
                for link in links[:500]:
                    link_path = os.path.join(path, link)
                    try:
                        link_target = os.readlink(link_path)[:1024]
                    except OSError:
                        link_target = None
                    enablement.append({"unit": link, "relation": relation, "target": target,
                                       "dir": unit_dir, "link_target": link_target})
                continue
            if name.endswith(".d") and os.path.isdir(path):
                try:
                    dropins = sorted(os.listdir(path))
                except OSError:
                    continue
                for dropin in dropins[:100]:
                    if dropin.endswith(".conf"):
                        dpath = os.path.join(path, dropin)
                        facts = file_facts(dpath)
                        facts.update({"name": name[:-2], "unit_dir": unit_dir, "role": "dropin"})
                        facts.update(_unit_details(dpath))
                        units.append(facts)
                continue
            if not name.endswith(UNIT_SUFFIXES):
                continue
            facts = file_facts(path)
            facts.update({"name": name, "unit_dir": unit_dir, "role": "unit"})
            if facts.get("kind") == "file":
                facts.update(_unit_details(path))
            units.append(facts)
    return units, enablement, truncated


def _split_addr(text: str) -> tuple[str | None, str | None, int | None]:
    """Parse ss 'Local Address:Port' -> (address, interface, port)."""
    if text.startswith("["):
        host, _, port = text[1:].partition("]:")
    else:
        host, _, port = text.rpartition(":")
    iface = None
    if "%" in host:
        host, _, iface = host.partition("%")
    try:
        port_num = int(port) if port not in ("*", "") else None
    except ValueError:
        port_num = None
    return (host or None), iface, port_num


_SS_UID = re.compile(r"(?:^|\s)uid:(\d{1,10})(?=\s|$)")
_SS_INO = re.compile(r"(?:^|\s)ino:(\d{1,20})(?=\s|$)")
_SS_CGROUP = re.compile(r"(?:^|\s)cgroup:(/[^\s]{0,1023})(?=\s|$)")


def parse_ss(text: str) -> list[dict[str, object]]:
    """Parse ``ss -H -t -u -l -n -p [-e --cgroup]`` output.

    Without root, ``users:(...)`` (pid/process) is only shown for the collector's own
    sockets, so ``processes`` stays null (unknown) for everything else. The extended
    fields come from the kernel (sock_diag) and need no privileges: ``uid`` is the
    socket owner uid (omitted by ss for uid 0), ``inode`` the socket inode and
    ``cgroup`` the cgroup v2 path of the process that created the socket (for systemd
    services ``/system.slice/<unit>``).
    """
    listeners: list[dict[str, object]] = []
    for line in text.splitlines():
        parts = line.split(None, 6)
        if len(parts) < 6:
            continue
        netid, state, local = parts[0], parts[1], parts[4]
        address, iface, port = _split_addr(local)
        processes: list[dict[str, object]] = []
        extra = parts[6] if len(parts) == 7 else ""
        for match in re.finditer(r'\("([^"]{1,64})",pid=(\d+),fd=(\d+)\)', extra):
            processes.append({"name": match.group(1), "pid": int(match.group(2))})
        uid = _SS_UID.search(extra)
        ino = _SS_INO.search(extra)
        cgroup = _SS_CGROUP.search(extra)
        entry: dict[str, object] = {
            "proto": netid, "state": state, "local_address": address, "interface": iface,
            "local_port": port,
            # Without root, ss only shows the owner of the collector's own sockets:
            # process stays unknown (null) rather than guessed.
            "processes": processes or None,
        }
        if ino is not None:
            # Extended output present: a missing uid field means uid 0 (ss omits it).
            entry["uid"] = int(uid.group(1)) if uid else 0
            entry["inode"] = int(ino.group(1))
        if cgroup is not None:
            entry["cgroup"] = cgroup.group(1)
        if "v6only:1" in extra:
            entry["v6only"] = True
        listeners.append(entry)
        if len(listeners) >= MAX_LISTENERS:
            break
    return listeners


def _cgroup_of(pid: int) -> str | None:
    """cgroup v2 path of a process (``0::/system.slice/nginx.service``); world-readable."""
    text = read_text(f"/proc/{pid}/cgroup", 4096)
    if not text:
        return None
    for line in text.splitlines():
        if line.startswith("0::"):
            return line[3:].strip()[:1024] or None
    return None


def collect_processes() -> tuple[list[dict[str, object]], bool]:
    procs: list[dict[str, object]] = []
    truncated = False
    user_cache: dict[int, str | None] = {}
    try:
        pids = sorted((int(p) for p in os.listdir("/proc") if p.isdigit()))
    except OSError:
        return procs, False
    for pid in pids:
        stat_text = read_text(f"/proc/{pid}/stat", 4096)
        if not stat_text or ")" not in stat_text:
            continue
        comm = stat_text[stat_text.find("(") + 1: stat_text.rfind(")")][:64]
        fields = stat_text[stat_text.rfind(")") + 2:].split()
        try:
            ppid = int(fields[1])
            start_ticks = int(fields[19])
        except (IndexError, ValueError):
            continue
        if pid == 2 or ppid == 2:
            continue  # kernel threads
        uid = None
        status = read_text(f"/proc/{pid}/status", 8192) or ""
        for line in status.splitlines():
            if line.startswith("Uid:"):
                try:
                    uid = int(line.split()[1])
                except (IndexError, ValueError):
                    uid = None
                break
        if uid is not None and uid not in user_cache:
            try:
                user_cache[uid] = pwd.getpwuid(uid).pw_name
            except KeyError:
                user_cache[uid] = None
        try:
            executable = os.readlink(f"/proc/{pid}/exe")
        except OSError:
            executable = ""
        procs.append({"pid": pid, "ppid": ppid, "uid": uid,
                      "user": user_cache.get(uid) if uid is not None else None,
                      "comm": comm, "executable": executable[:1024], "start_ticks": start_ticks,
                      "cgroup": _cgroup_of(pid)})
        if len(procs) >= MAX_PROCESSES:
            truncated = True
            break
    return procs, truncated


def collect_users() -> tuple[list[dict[str, object]], dict[str, list[str]]]:
    users: list[dict[str, object]] = []
    groups_by_user: dict[str, list[str]] = {}
    group_names_by_gid: dict[int, str] = {}
    privileged: dict[str, list[str]] = {}
    try:
        all_groups = grp.getgrall()
    except OSError:
        all_groups = []
    for group in all_groups:
        group_names_by_gid[group.gr_gid] = group.gr_name
        for member in group.gr_mem:
            groups_by_user.setdefault(member, []).append(group.gr_name)
        if group.gr_name in PRIVILEGED_GROUPS:
            privileged[group.gr_name] = sorted(group.gr_mem)[:200]
    for entry in pwd.getpwall()[:MAX_USERS]:
        primary = group_names_by_gid.get(entry.pw_gid)
        member_of = sorted(set(groups_by_user.get(entry.pw_name, []) + ([primary] if primary else [])))
        users.append({"name": entry.pw_name[:64], "uid": entry.pw_uid, "gid": entry.pw_gid,
                      "home": entry.pw_dir[:256], "shell": entry.pw_shell[:256],
                      "groups": member_of[:64]})
    return users, privileged


def collect_cron() -> list[dict[str, object]]:
    entries: list[dict[str, object]] = []
    for path in CRON_PATHS:
        facts = file_facts(path)
        if facts.get("exists"):
            entries.append(facts)
    for cron_dir in CRON_DIRS:
        try:
            names = sorted(os.listdir(cron_dir))
        except FileNotFoundError:
            continue
        except OSError:
            entries.append({"path": cron_dir, "kind": "dir", "readable": False})
            continue
        for name in names:
            if len(entries) >= MAX_CRON:
                return entries
            entries.append(file_facts(os.path.join(cron_dir, name)))
    return entries


def collect_sensitive_files() -> list[dict[str, object]]:
    result: list[dict[str, object]] = []
    for path in SENSITIVE_FILES:
        result.append(file_facts(path))
    for pattern in SENSITIVE_GLOBS:
        parent = os.path.dirname(pattern)
        try:
            os.listdir(parent)
        except FileNotFoundError:
            continue
        except OSError:
            result.append({"path": parent, "kind": "dir", "readable": False})
            continue
        for path in sorted(glob.glob(pattern))[:200]:
            result.append(file_facts(path))
    return result


NGINX_ROOT = "/etc/nginx"
NGINX_MAX_FILES = 64
NGINX_MAX_DEPTH = 8
#: Directives reported from nginx configuration (values only, never file contents).
NGINX_DIRECTIVES = ("listen", "server_name", "proxy_pass", "access_log", "error_log",
                    "server_tokens", "user", "include")


def tokenize_nginx(text: str) -> list[str]:
    """Split nginx configuration into tokens: words, quoted strings, ';', '{', '}'."""
    tokens: list[str] = []
    i, n = 0, len(text)
    while i < n:
        ch = text[i]
        if ch.isspace():
            i += 1
        elif ch == "#":
            end = text.find("\n", i)
            i = n if end < 0 else end + 1
        elif ch in ";{}":
            tokens.append(ch)
            i += 1
        elif ch in "\"'":
            end = i + 1
            while end < n and text[end] != ch:
                end += 2 if text[end] == "\\" else 1
            tokens.append(text[i + 1:end][:1024])
            i = end + 1
        else:
            start = i
            while i < n and not text[i].isspace() and text[i] not in ";{}#\"'":
                i += 1
            tokens.append(text[start:i][:1024])
    return tokens


def parse_nginx_config(root: str = NGINX_ROOT + "/nginx.conf") -> dict[str, object]:
    """Selected nginx directives per context (main / http / server / location).

    Only files under /etc/nginx are followed (``include`` globs), bounded in count,
    depth and size. The result lists directive *values* (ports, upstream targets,
    log destinations) used as configuration evidence for service discovery.
    """
    files_read: list[str] = []
    unreadable: list[str] = []
    contexts: list[dict[str, object]] = []

    def new_context(kind: str, path: str) -> dict[str, object]:
        ctx: dict[str, object] = {"context": kind, "file": path, "directives": {}}
        if len(contexts) < 128:
            contexts.append(ctx)
        return ctx

    def add(ctx: dict[str, object], name: str, args: list[str]) -> None:
        directives = ctx["directives"]
        assert isinstance(directives, dict)
        values = directives.setdefault(name, [])
        if len(values) < 16:
            values.append(" ".join(args)[:512])

    def parse_file(path: str, depth: int, stack: list[dict[str, object]]) -> None:
        if depth > NGINX_MAX_DEPTH or len(files_read) + len(unreadable) >= NGINX_MAX_FILES:
            return
        real = os.path.realpath(path)
        if not (real == NGINX_ROOT or real.startswith(NGINX_ROOT + "/")):
            unreadable.append(path)  # outside /etc/nginx: never followed
            return
        text = read_text(path, limit=256 * 1024)
        if text is None:
            unreadable.append(path)
            return
        files_read.append(path)
        tokens = tokenize_nginx(text)
        args: list[str] = []
        local_stack = list(stack)
        for token in tokens:
            if token == ";":
                if args:
                    name = args[0]
                    if name == "include" and len(args) > 1:
                        pattern = args[1]
                        full = pattern if pattern.startswith("/") else os.path.join(NGINX_ROOT, pattern)
                        for inc in sorted(glob.glob(full))[:NGINX_MAX_FILES]:
                            parse_file(inc, depth + 1, local_stack)
                    elif name in NGINX_DIRECTIVES:
                        add(local_stack[-1], name, args[1:])
                args = []
            elif token == "{":
                kind = args[0] if args else "block"
                if kind in ("http", "server", "location", "stream", "upstream"):
                    ctx = new_context(kind, path)
                    if kind == "location" and len(args) > 1:
                        ctx["match"] = " ".join(args[1:])[:256]
                    local_stack.append(ctx)
                else:
                    local_stack.append({"context": kind, "file": path, "directives": {}})
                args = []
            elif token == "}":
                if len(local_stack) > 1:
                    local_stack.pop()
                args = []
            else:
                if len(args) < 32:
                    args.append(token)

    main = new_context("main", root)
    parse_file(root, 0, [main])
    return {"files_read": files_read, "unreadable": unreadable,
            "contexts": [c for c in contexts if c["directives"]]}


def collect_configs() -> dict[str, object]:
    """Configuration references of known services (values only; no secrets in scope)."""
    configs: dict[str, object] = {}
    if os.path.exists("/etc/ssh/sshd_config"):
        sshd = parse_sshd_config()
        multi = sshd.get("multi") or {}
        settings = sshd.get("settings") or {}
        assert isinstance(multi, dict) and isinstance(settings, dict)
        configs["sshd"] = {
            "files_read": sshd["files_read"],
            "unreadable": sshd["unreadable"],
            "port": multi.get("port") or [],
            "listenaddress": multi.get("listenaddress") or [],
            "loglevel": (settings.get("loglevel") or {}).get("value"),
        }
    if os.path.exists(NGINX_ROOT + "/nginx.conf"):
        configs["nginx"] = parse_nginx_config()
    return configs


def collect_listeners(errors: list[str]) -> list[dict[str, object]]:
    base = ["/usr/bin/ss", "-H", "-t", "-u", "-l", "-p", "-n"]
    for argv in (base + ["-e", "--cgroup"], base):
        try:
            rc, out, err = run_fixed(argv, timeout=20)
        except DispatchFailure as exc:
            errors.append(str(exc))
            return []
        if rc == 0:
            return parse_ss(out.decode("utf-8", "replace"))
        errors.append("ss: " + (first_line(err) or f"exit {rc}"))
    return []


def cmd_inventory(_command: Command) -> int:
    errors: list[str] = []
    units, enablement, units_truncated = collect_units()
    listeners = collect_listeners(errors)
    processes, procs_truncated = collect_processes()
    users, privileged = collect_users()
    emit_json({
        "type": "inventory",
        "protocol": PROTOCOL,
        "collected_at": utc_now(),
        "host": host_facts(),
        "systemd_units": units,
        "enablement": enablement,
        "listeners": listeners,
        "processes": processes,
        "users": users,
        "privileged_groups": privileged,
        "cron": collect_cron(),
        "sensitive_files": collect_sensitive_files(),
        "configs": collect_configs(),
        "truncated": {"systemd_units": units_truncated, "processes": procs_truncated},
        "errors": errors,
    })
    return EXIT_OK


