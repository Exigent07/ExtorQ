def parse_sshd_config(root: str = "/etc/ssh/sshd_config") -> dict[str, object]:
    """Effective *global* sshd settings from config files (first value wins).

    sshd -T needs root (host keys), so the files are parsed directly. Match blocks
    are recorded separately and never override global values here.
    """
    settings: dict[str, dict[str, str]] = {}
    # Keywords that may appear several times and all apply (global scope only).
    multi: dict[str, list[str]] = {"port": [], "listenaddress": []}
    matches: list[dict[str, object]] = []
    files_read: list[str] = []
    unreadable: list[str] = []

    def process(path: str, depth: int, in_match: dict[str, object] | None) -> None:
        if depth > 8:
            return
        text = read_text(path, limit=512 * 1024)
        if text is None:
            unreadable.append(path)
            return
        files_read.append(path)
        current = in_match
        for raw in text.splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split(None, 1)
            keyword = parts[0].lower()
            value = parts[1].strip() if len(parts) > 1 else ""
            if "=" in parts[0]:
                keyword, _, value = line.partition("=")
                keyword = keyword.strip().lower()
            # sshd accepts "Keyword value", "Keyword=value" and "Keyword = value".
            value = value.strip()
            if value.startswith("="):
                value = value[1:].strip()
            if len(value) >= 2 and value[0] == value[-1] == '"':
                value = value[1:-1]
            if keyword == "match":
                current = {"criteria": value[:256], "file": path, "settings": {}}
                matches.append(current)
                continue
            if keyword == "include":
                for pattern in value.split():
                    full = pattern if pattern.startswith("/") else os.path.join("/etc/ssh", pattern)
                    for inc in sorted(glob.glob(full)):
                        process(inc, depth + 1, current)
                continue
            if current is not None:
                current_settings = current["settings"]
                assert isinstance(current_settings, dict)
                current_settings.setdefault(keyword, value[:256])
            else:
                if keyword in multi and len(multi[keyword]) < 16:
                    multi[keyword].append(value[:256])
                if keyword not in settings:
                    settings[keyword] = {"value": value[:256], "file": path}

    process(root, 0, None)
    return {"settings": settings, "multi": multi, "match_blocks": matches[:32],
            "files_read": files_read, "unreadable": unreadable}


def parse_apt_periodic() -> dict[str, object]:
    values: dict[str, str] = {}
    files = sorted(glob.glob("/etc/apt/apt.conf.d/*"))
    for path in files:
        text = read_text(path, limit=256 * 1024)
        if text is None:
            continue
        for match in re.finditer(r'(APT::Periodic::[A-Za-z-]+)\s+"([^"]*)"\s*;', text):
            values[match.group(1)] = match.group(2)[:64]  # later files override earlier
    return values


def systemctl_state(verb: str, unit: str) -> str | None:
    try:
        rc, out, _ = run_fixed(["/usr/bin/systemctl", verb, unit], timeout=10)
    except DispatchFailure:
        return None
    text = out.decode("utf-8", "replace").strip()
    return text.splitlines()[0][:64] if text else None


def read_sysctls() -> dict[str, str | None]:
    values: dict[str, str | None] = {}
    for name in SYSCTLS:
        text = read_text("/proc/sys/" + name.replace(".", "/"), limit=256)
        values[name] = text.strip() if text is not None else None
    return values


def pending_security_updates() -> dict[str, object]:
    try:
        rc, out, err = run_fixed(["/usr/bin/apt", "list", "--upgradable"], timeout=90)
    except DispatchFailure as exc:
        return {"available": False, "error": str(exc), "packages": []}
    if rc != 0:
        return {"available": False, "error": first_line(err) or f"exit {rc}", "packages": []}
    packages: list[dict[str, object]] = []
    total = 0
    pattern = re.compile(r"^([^/\s]+)/(\S+)\s+(\S+)\s+(\S+)(?:\s+\[upgradable from:\s+([^\]]+)\])?")
    for line in out.decode("utf-8", "replace").splitlines():
        match = pattern.match(line)
        if not match:
            continue
        total += 1
        suites = match.group(2).split(",")
        if not any(s.endswith("-security") for s in suites):
            continue
        packages.append({"name": match.group(1)[:128], "suites": suites[:8],
                         "candidate": match.group(3)[:128], "architecture": match.group(4)[:32],
                         "installed": (match.group(5) or "")[:128] or None})
        if len(packages) >= 2000:
            break
    lists_mtime = None
    for stamp in ("/var/lib/apt/periodic/update-success-stamp", "/var/lib/apt/lists"):
        try:
            lists_mtime = int(os.stat(stamp).st_mtime)
            break
        except OSError:
            continue
    return {"available": True, "error": None, "packages": packages, "upgradable_total": total,
            "apt_lists_mtime": lists_mtime}


def cmd_posture(_command: Command) -> int:
    ufw_text = read_text("/etc/ufw/ufw.conf")
    ufw_enabled = None
    if ufw_text is not None:
        match = re.search(r"^\s*ENABLED\s*=\s*(\S+)", ufw_text, re.MULTILINE)
        ufw_enabled = match.group(1).strip("\"'").lower() if match else None
    apparmor = read_text("/sys/module/apparmor/parameters/enabled")
    reboot_pkgs = read_text("/var/run/reboot-required.pkgs", limit=64 * 1024)
    readable_by_collector = {}
    for path in ("/etc/shadow", "/etc/gshadow", "/etc/sudoers", "/etc/ssh/ssh_host_ed25519_key"):
        # access() only: content of these files is never read.
        readable_by_collector[path] = os.access(path, os.R_OK) if os.path.exists(path) else None
    passwd_uid0 = [u.pw_name for u in pwd.getpwall() if u.pw_uid == 0][:16]
    emit_json({
        "type": "posture",
        "protocol": PROTOCOL,
        "collected_at": utc_now(),
        "host": host_facts(),
        "checks": {
            "sshd": parse_sshd_config(),
            "apt_periodic": parse_apt_periodic(),
            "unattended_upgrades": {
                "installed": os.path.exists("/usr/bin/unattended-upgrade"),
                "service_enabled": systemctl_state("is-enabled", "unattended-upgrades.service"),
                "upgrade_timer_enabled": systemctl_state("is-enabled", "apt-daily-upgrade.timer"),
            },
            "auditd": {
                "active": systemctl_state("is-active", "auditd.service"),
                "enabled": systemctl_state("is-enabled", "auditd.service"),
            },
            "apparmor": {"enabled": apparmor.strip() if apparmor is not None else None},
            "ufw": {"config_readable": ufw_text is not None, "enabled": ufw_enabled},
            "sysctl": read_sysctls(),
            "reboot_required": {
                "required": os.path.exists("/var/run/reboot-required"),
                "packages": sorted(set(reboot_pkgs.split()))[:64] if reboot_pkgs else [],
            },
            "security_updates": pending_security_updates(),
            "file_access": readable_by_collector,
            "uid0_accounts": passwd_uid0,
        },
    })
    return EXIT_OK


# ── main ───────────────────────────────────────────────────────────────────────

HANDLERS = {
    "journal": cmd_journal,
    "audit": cmd_audit,
    "inventory": cmd_inventory,
    "packages": cmd_packages,
    "posture": cmd_posture,
}


def cmd_version(_command: Command) -> int:
    emit_json({
        "type": "version",
        "protocol": PROTOCOL,
        "dispatcher": "extorq-collect-dispatch",
        "version": DISPATCHER_VERSION,
        "commands": ["version"] + sorted(HANDLERS),
        "limits": {"journal_max_entries": MAX_JOURNAL_ENTRIES, "audit_max_bytes": MAX_AUDIT_BYTES},
        "hostname": os.uname().nodename,
        "user": pwd.getpwuid(os.getuid()).pw_name,
    })
    return EXIT_OK


def _log_denial(raw: str | None, reason: str) -> None:
    """Record a boundary violation in the journal (content never logged verbatim)."""
    try:
        import syslog

        data = (raw or "").encode("utf-8", "replace")
        first = (raw or "").split(" ", 1)[0]
        token = first if re.fullmatch(r"[a-z]{1,16}", first) else "?"
        syslog.openlog("extorq-collect-dispatch", syslog.LOG_PID, syslog.LOG_AUTHPRIV)
        syslog.syslog(syslog.LOG_WARNING,
                      "denied command: command_word=%s length=%d sha256=%s reason=%s"
                      % (token, len(data), hashlib.sha256(data).hexdigest()[:16], reason[:80]))
        syslog.closelog()
    except Exception:  # noqa: BLE001 - logging must never change the decision
        pass


def main() -> int:
    signal.alarm(WATCHDOG_SECONDS)
    raw = os.environ.get("SSH_ORIGINAL_COMMAND")
    try:
        command = parse_command(raw)
    except Denied as exc:
        _log_denial(raw, str(exc))
        sys.stderr.write("denied\n")
        return EXIT_DENIED
    handler = cmd_version if command.name == "version" else HANDLERS[command.name]
    try:
        return handler(command)
    except DispatchFailure as exc:
        sys.stdout.flush()
        sys.stderr.write("error: %s\n" % str(exc)[:200])
        return EXIT_TEMPFAIL if "timed out" in str(exc) or "retry" in str(exc) else EXIT_SOFTWARE
    except BrokenPipeError:
        return EXIT_TEMPFAIL
    except Exception as exc:  # noqa: BLE001 - never leak tracebacks to the caller
        sys.stderr.write("error: internal %s\n" % type(exc).__name__)
        return EXIT_SOFTWARE


if __name__ == "__main__":
    sys.exit(main())
