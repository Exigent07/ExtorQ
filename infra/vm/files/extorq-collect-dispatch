def cmd_packages(_command: Command) -> int:
    fmt = ("${db:Status-Abbrev}\\t${Package}\\t${Version}\\t${Architecture}\\t"
           "${source:Package}\\t${source:Version}\\n")
    rc, out, err = run_fixed(["/usr/bin/dpkg-query", "-W", "-f=" + fmt])
    if rc != 0:
        raise DispatchFailure("dpkg-query failed: " + (first_line(err) or f"exit {rc}"))
    packages: list[dict[str, str]] = []
    truncated = False
    for line in out.decode("utf-8", "replace").splitlines():
        parts = line.split("\t")
        if len(parts) != 6:
            continue
        status = parts[0].strip()
        if len(status) < 2 or status[1] in ("n", "c"):
            continue  # not installed / config files only
        packages.append({"name": parts[1][:128], "version": parts[2][:128],
                         "architecture": parts[3][:32], "source_name": parts[4][:128],
                         "source_version": parts[5][:128], "status": status[:3]})
        if len(packages) >= MAX_PACKAGES:
            truncated = True
            break
    arch = None
    try:
        rc_arch, arch_out, _ = run_fixed(["/usr/bin/dpkg", "--print-architecture"], timeout=10)
        if rc_arch == 0:
            arch = arch_out.decode("ascii", "replace").strip()[:32] or None
    except DispatchFailure:
        arch = None
    emit_json({
        "type": "packages",
        "protocol": PROTOCOL,
        "schema": "extorq.linux.packages.v1",
        "collected_at": utc_now(),
        "hostname": os.uname().nodename,
        "os_release": os_release(),
        "dpkg_architecture": arch,
        "packages": packages,
        "count": len(packages),
        "truncated": truncated,
        "errors": [],
    })
    return EXIT_OK


