{
  "name": "extorq-console",
  "version": "0.1.0",
  "private": true,
  "description": "ExtorQ Security Console: server-rendered analyst UI for the ExtorQ mini SIEM",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3100 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --port 3100 --hostname 127.0.0.1",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "gen:api": "openapi-typescript ../docs/api/openapi.json --output src/lib/api/openapi.d.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "geist": "1.9.2",
    "jose": "6.2.17",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
