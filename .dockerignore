# Never send secrets, local state or bulky caches to the Docker daemon.
var/
.env
.env.*
!.env.example
**/*.pem
**/*.key
**/*.token
secrets/
.git/
.github/
.venv/
**/.venv/
**/node_modules/
**/.next/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite*
**/*.qcow2
**/*.img
**/*.iso
.DS_Store
.idea/
.vscode/
.claude/
