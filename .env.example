# ExtorQ environment template — variable NAMES with safe placeholders only.
# Copy to .env and fill in real values. Never commit .env.
#
# AI providers (optional: ExtorQ fully works without them; features disable cleanly).
# JEV_API_KEY is mapped internally to the TypeSafe SDK (TypeSafeClient(api_key=...)).
JEV_API_KEY=replace-with-typesafe-api-key
GEMINI_API_KEY=replace-with-gemini-api-key

# Non-secret AI opt-in flags read by compose (both providers are OFF by default):
# EXTORQ_JEV_ENABLED=true        # ai-worker: Jev triage of new alerts (budgeted)
# EXTORQ_GEMINI_ENABLED=true     # api: on-demand Gemini summaries (budgeted)

# Everything else (ClickHouse passwords, producer tokens, Grafana/analyst
# passwords, TLS material) is generated by `make bootstrap` into var/secrets/
# and var/tls/ with 0600 permissions. Non-secret settings use EXTORQ_* variables
# documented in docs/deployment.md.
